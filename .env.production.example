# Production Environment Configuration for CyberThreat AI

# Domain & Security
ENVIRONMENT=production
CYBERTHREAT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_64_char_key_2026
CORS_ORIGINS=https://cyberthreat.ai,https://app.cyberthreat.ai

# Database - Managed PostgreSQL (Internal network only, no public port)
DATABASE_URL=postgresql://cyberthreat_admin:StrongPassword2026!@db:5432/cyberthreat_production
POSTGRES_USER=cyberthreat_admin
POSTGRES_PASSWORD=StrongPassword2026!
POSTGRES_DB=cyberthreat_production

# Host Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_URL=https://api.cyberthreat.ai

# Frontend URL
VITE_API_URL=https://api.cyberthreat.ai/api
FRONTEND_URL=https://cyberthreat.ai

# Threat Engine Thresholds
INCIDENT_RISK_THRESHOLD=30
CORRELATION_TIME_WINDOW=600
SYNC_INTERVAL=30
SYNC_RETRY_MAX=3
